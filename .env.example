# The server is loopback-only unless you explicitly opt into LAN access.
CLEVERSPA_HOST=127.0.0.1
CLEVERSPA_PORT=8787

# Required when CLEVERSPA_HOST is not loopback. Use a long random value.
CLEVERSPA_ACCESS_TOKEN=

# Optional known spa details. Discovery can fill the IP at runtime.
CLEVERSPA_IP=
CLEVERSPA_PASSCODE=

# Cloud account login is accepted from loopback by default. Setting this to
# true permits credentials to cross an unencrypted LAN, which is discouraged.
CLEVERSPA_ALLOW_LAN_CREDENTIAL_LOGIN=false
